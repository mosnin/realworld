# Public runtime identity only. Do not put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_ENV=development

# Durable collaboration service (Convex).
NEXT_PUBLIC_CONVEX_URL=

# Ephemeral realtime service (Ably); browser tokens must be issued server-side.
ABLY_API_KEY=

# Agent providers. Server-only; never expose as NEXT_PUBLIC_*.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
